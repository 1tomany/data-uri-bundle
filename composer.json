{
    "name": "1tomany/data-uri-bundle",
    "description": "Symfony bundle that provides bindings for the 1tomany/data-uri package",
    "license": "MIT",
    "type": "symfony-bundle",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "1tomany/data-uri": "^7.0",
        "symfony/config": "^7.2|^8.0|^8.1",
        "symfony/console": "^7.2|^8.0|^8.1",
        "symfony/dependency-injection": "^7.2|^8.0|^8.1",
        "symfony/http-kernel": "^7.2|^8.0|^8.1",
        "symfony/serializer": "^7.2|^8.0|^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.93",
        "phpstan/phpstan": "^2.1.55",
        "phpunit/phpunit": "^13.1.11"
    },
    "autoload": {
        "psr-4": {
            "OneToMany\\DataUriBundle\\": "src/"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OneToMany\\DataUriBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": "php-cs-fixer fix",
        "stan": "phpstan",
        "test": "phpunit",
        "flat": [
            "@fix",
            "@stan",
            "@test"
        ]
    },
    "authors": [
        {
            "name": "Vic Cherubini",
            "email": "vcherubini@gmail.com"
        }
    ],
    "config": {
        "sort-packages": true
    }
}
